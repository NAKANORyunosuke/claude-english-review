{
	"_comment": [
		"雛形。プロジェクトごとに複製して値を埋める。パスは実在するものへ直すこと。",
		"tex には投稿する正本を書く。研究ノートや旧版を指したまま使うと、点検が",
		"公開しない文書に向かって空回りする。derived は正本から生成する派生物。",
		"approved_terms は廃止した用語を残さない。残すと coinage_scan.py がその語を",
		"造語候補から除外してしまい、廃止語の残存を検出できない。"
	],
	"project": "<プロジェクト名>",
	"tex": "<repo>/paper/paper-arxiv.tex",
	"derived": [],
	"rules": "<plugin>/rules/english-writing-rules.md",
	"term_rules": "<plugin>/rules/terminology-rules.md",
	"notation_rules": "<plugin>/rules/notation-rules.md",
	"style_source": [
		"<EnglishBible>/mathematical-writing.md",
		"<EnglishBible>/matsumoto-style-guide.md"
	],
	"ledger": "<repo>/paper/notation-ledger.md",
	"audit": "py <skills>/tex-style-audit/audit_tex.py {tex} --banned <skills>/tex-style-audit/banned-terms-<project>.txt",
	"build": "pdflatex -synctex=1 -interaction=nonstopmode -halt-on-error {tex}",
	"build_passes": 2,
	"chunk_lines": 480,
	"approved_terms": [],
	"prior_works": [],
	"findings_dir": "<repo>/paper/review",
	"handover": "<findings_dir>/HANDOVER.md",
	"process_defects": "<findings_dir>/PROCESS-DEFECTS.md",
	"review_status": "py <plugin>/tools/review_status.py <findings_dir> --write",
	"ledger_gate": "py <plugin>/tools/ledger_gate.py {tex} {ledger}",
	"symbol_depgraph": "py <plugin>/tools/symbol_depgraph.py {tex}",
	"apply_renames": "py <plugin>/tools/apply_renames.py {tex} <renames.json> --apply",
	"archive_dir": "<追跡外の作業領域>"
}
